FROM quay.io/jupyter/scipy-notebook:x86_64-2025-05-30

# Устанавливаем зависимости проекта и закреплённые пакеты CUDA/cuGraph один раз при сборке образа.
COPY requirements.txt /tmp/practice2-requirements.txt
RUN pip install --no-cache-dir --extra-index-url https://pypi.nvidia.com \
    -r /tmp/practice2-requirements.txt \
    nx-cugraph-cu12==25.4.0 \
    "cupy-cuda12x[ctk]==14.2.0"
